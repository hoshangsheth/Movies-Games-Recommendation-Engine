# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Set this to your deployed frontend's origin in production.
FRONTEND_ORIGIN=

# --- Model artifact storage ---
# Where the downloaded movie/game dataframes + similarity matrices are
# cached on disk. Defaults to /tmp/recommender-artifacts if unset.
MODEL_DOWNLOAD_DIR=/tmp/recommender-artifacts

# --- Contact form (Google Sheets) ---
# Either a path to a service-account JSON key file, or the raw JSON
# content of one (useful for setting this as a single secret in CI/CD).
GOOGLE_SERVICE_ACCOUNT_JSON=
