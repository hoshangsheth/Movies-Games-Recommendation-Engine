# This project uses two separate env files:
#
#   backend/.env   — see backend/.env.example for FastAPI / Google Sheets config
#   frontend/.env  — see frontend/.env.example for the API base URL
#
# Copy each example file in place before running `docker compose up` or
# starting the services individually:
#
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
